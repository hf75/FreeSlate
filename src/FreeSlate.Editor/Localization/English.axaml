<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="FreeSlate.Editor.Localization.English">
  <x:String x:Key="CaptionFullScreen">Full Screen</x:String>
  <x:String x:Key="CaptionExitFullScreen">Exit Full Screen</x:String>
  <x:String x:Key="CaptionMinimize">Minimize</x:String>
