  <x:String x:Key="CaptionRestore">Restore Down</x:String>
  <x:String x:Key="CaptionClose">Close</x:String>
  <x:String x:Key="EmptyLine">A clean slate.</x:String>
  <x:String x:Key="LanguageChoice">Language</x:String>
</ResourceDictionary>
