  <x:String x:Key="TonePlain">Sachlich</x:String>
  <x:String x:Key="ToneMagazine">Magazin</x:String>
  <x:String x:Key="ToneNotebook">Notizbuch</x:String>
  <x:String x:Key="ShowMeanings">Bedeutung zeigen</x:String>
  <x:String x:Key="MeaningImportant">Wichtig</x:String>
  <x:String x:Key="MeaningEmphasized">Betonung</x:String>
  <x:String x:Key="MeaningTerm">Begriff</x:String>
