<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="FreeSlate.Editor.Localization.German">
  <x:String x:Key="CaptionMinimize">Minimieren</x:String>
  <x:String x:Key="CaptionMaximize">Maximieren</x:String>
  <x:String x:Key="CaptionRestore">Verkleinern</x:String>
  <x:String x:Key="CaptionClose">Schließen</x:String>
  <x:String x:Key="EmptyLine">Ein unbeschriebenes Blatt.</x:String>
  <x:String x:Key="LanguageChoice">Sprache</x:String>
</ResourceDictionary>
