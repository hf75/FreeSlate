<Panel xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       x:Class="FreeSlate.Editor.EditorView">

  <!-- The empty editor: a line a little above the middle. -->
  <Grid RowDefinitions="4*,Auto,5*">
    <TextBlock Grid.Row="1"
               Text="{DynamicResource EmptyLine}"
               Foreground="{DynamicResource InkSoft}"
               FontSize="28"
               FontWeight="Light"
               LetterSpacing="-0.6"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="24,0" />
  </Grid>

  <StackPanel x:Name="Languages"
              Orientation="Horizontal"
              Spacing="4"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,16"
              AutomationProperties.Name="{DynamicResource LanguageChoice}"
              AutomationProperties.IsControlElementOverride="True" />
</Panel>
