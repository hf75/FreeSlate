<tone xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
  <!--
    Sachlich (plain): Inter, ragged right, a clear hierarchy, colour only where the text asks for attention. A tone defines the
    styles of the levels and of the meanings and the lists they name, nothing else (see Tones); {Name} stands for the name of a
    meaning or a level in the language of the interface. The editor's documents hyphenate (in Word a setting of the whole
    document); a tone that does not suppresses it in its normal paragraph, which the others are based on.
  -->
  <w:styles>
    <w:style w:type="paragraph" w:default="1" w:styleId="Normal">
      <w:name w:val="Normal" />
      <w:qFormat />
      <w:pPr><w:suppressAutoHyphens /><w:spacing w:before="0" w:after="160" w:line="336" w:lineRule="auto" /></w:pPr>
      <w:rPr><w:rFonts w:ascii="Inter" w:hAnsi="Inter" w:eastAsia="Inter" w:cs="Inter" /><w:color w:val="222222" /><w:sz w:val="21" /><w:szCs w:val="21" /></w:rPr>
    </w:style>
    <w:style w:type="paragraph" w:styleId="Title">
      <w:name w:val="Title" />
      <w:basedOn w:val="Normal" />
      <w:next w:val="Normal" />
      <w:qFormat />
      <w:pPr><w:keepNext /><w:keepLines /><w:spacing w:before="0" w:after="280" w:line="264" w:lineRule="auto" /></w:pPr>
      <w:rPr><w:b /><w:bCs /><w:color w:val="111111" /><w:spacing w:val="-10" /><w:sz w:val="48" /><w:szCs w:val="48" /></w:rPr>
    </w:style>
    <w:style w:type="paragraph" w:styleId="Heading1">
      <w:name w:val="heading 1" />
      <w:basedOn w:val="Normal" />
      <w:next w:val="Normal" />
      <w:qFormat />
      <w:pPr><w:keepNext /><w:keepLines /><w:spacing w:before="400" w:after="120" w:line="276" w:lineRule="auto" /><w:outlineLvl w:val="0" /></w:pPr>
      <w:rPr><w:b /><w:bCs /><w:color w:val="111111" /><w:sz w:val="30" /><w:szCs w:val="30" /></w:rPr>
    </w:style>
    <w:style w:type="paragraph" w:styleId="Heading2">
      <w:name w:val="heading 2" />
      <w:basedOn w:val="Normal" />
      <w:next w:val="Normal" />
      <w:qFormat />
      <w:pPr><w:keepNext /><w:keepLines /><w:spacing w:before="280" w:after="80" w:line="288" w:lineRule="auto" /><w:outlineLvl w:val="1" /></w:pPr>
      <w:rPr><w:rFonts w:ascii="Inter SemiBold" w:hAnsi="Inter SemiBold" w:eastAsia="Inter SemiBold" w:cs="Inter SemiBold" /><w:color w:val="111111" /><w:sz w:val="24" /><w:szCs w:val="24" /></w:rPr>
    </w:style>
    <w:style w:type="paragraph" w:styleId="ListBullet">
      <w:name w:val="List Bullet" />
      <w:basedOn w:val="Normal" />
      <w:qFormat />
      <w:pPr><w:numPr><w:numId w:val="9001" /></w:numPr><w:spacing w:after="60" /></w:pPr>
    </w:style>
    <w:style w:type="paragraph" w:styleId="ListBullet2">
      <w:name w:val="List Bullet 2" />
      <w:basedOn w:val="Normal" />
      <w:qFormat />
      <w:pPr><w:numPr><w:ilvl w:val="1" /><w:numId w:val="9001" /></w:numPr><w:spacing w:after="60" /></w:pPr>
    </w:style>
    <w:style w:type="paragraph" w:styleId="MarginNote">
      <w:name w:val="{MarginNote}" />
      <w:basedOn w:val="Normal" />
      <w:next w:val="Normal" />
      <w:qFormat />
      <w:pPr><w:pBdr><w:top w:val="single" w:sz="4" w:space="4" w:color="CFCCC4" /></w:pBdr><w:spacing w:before="120" w:after="200" w:line="288" w:lineRule="auto" /><w:ind w:left="4536" /></w:pPr>
      <w:rPr><w:i /><w:iCs /><w:color w:val="66645E" /><w:sz w:val="18" /><w:szCs w:val="18" /></w:rPr>
    </w:style>
    <w:style w:type="character" w:styleId="Important">
      <w:name w:val="{Important}" />
      <w:qFormat />
      <w:rPr><w:shd w:val="clear" w:color="auto" w:fill="FFF0A8" /></w:rPr>
    </w:style>
    <w:style w:type="character" w:styleId="Emphasized">
      <w:name w:val="{Emphasized}" />
      <w:qFormat />
      <w:rPr><w:i /><w:iCs /></w:rPr>
    </w:style>
    <w:style w:type="character" w:styleId="Term">
      <w:name w:val="{Term}" />
      <w:qFormat />
      <w:rPr><w:b /><w:bCs /></w:rPr>
    </w:style>
    <w:style w:type="character" w:styleId="Quotation">
      <w:name w:val="{Quotation}" />
      <w:qFormat />
      <w:rPr><w:i /><w:iCs /><w:color w:val="555555" /></w:rPr>
    </w:style>
    <w:style w:type="character" w:styleId="OpenQuestion">
      <w:name w:val="{OpenQuestion}" />
      <w:qFormat />
      <w:rPr><w:color w:val="C2410C" /><w:u w:val="wave" w:color="EA580C" /></w:rPr>
    </w:style>
  </w:styles>
  <w:numbering>
    <w:abstractNum w:abstractNumId="9001">
      <w:lvl w:ilvl="0"><w:start w:val="1" /><w:numFmt w:val="bullet" /><w:lvlText w:val="•" /><w:lvlJc w:val="left" /><w:pPr><w:ind w:left="340" w:hanging="220" /></w:pPr></w:lvl>
      <w:lvl w:ilvl="1"><w:start w:val="1" /><w:numFmt w:val="bullet" /><w:lvlText w:val="–" /><w:lvlJc w:val="left" /><w:pPr><w:ind w:left="680" w:hanging="220" /></w:pPr></w:lvl>
    </w:abstractNum>
    <w:num w:numId="9001"><w:abstractNumId w:val="9001" /></w:num>
  </w:numbering>
</tone>
