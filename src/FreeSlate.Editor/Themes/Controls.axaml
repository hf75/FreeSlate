<!--
  How the controls look, whatever the theme: all colours are dynamic resources of the theme's dictionary. Text is smoothed without
  colour fringes and keeps the shapes of its font, on every screen alike; each root of a visual tree says so.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:FreeSlate.Editor.Controls">

  <!-- Named here, as the default font differs from platform to platform (a monospaced one in the browser). -->
  <FontFamily x:Key="UiFont">fonts:Inter#Inter</FontFamily>

  <x:Double x:Key="TitleBarHeight">40</x:Double>

  <ControlTheme x:Key="{x:Type Window}" TargetType="Window">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Background" Value="{DynamicResource Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel TextOptions.TextRenderingMode="Antialias" TextOptions.TextHintingMode="None">
          <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
          <!-- Takes the client area's clicks; above it the title bar's layer gets them. -->
          <Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
          <VisualLayerManager Name="PART_VisualLayerManager">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding WindowDecorationMargin}" />
          </VisualLayerManager>
          <!-- In full screen the frame is gone: this takes its place, from the screen's top edge on. -->
          <c:CaptionBar Name="PART_FullScreenBar"
                        ForFullScreen="True"
                        IsVisible="False"
                        VerticalAlignment="Top"
                        Height="{StaticResource TitleBarHeight}"
                        Background="{DynamicResource Canvas}">
            <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1" IsHitTestVisible="False" />
            <TextBlock Text="{TemplateBinding Title}"
                       Foreground="{DynamicResource InkFaint}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="92,0"
                       IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <c:CaptionButton Job="ToggleFullScreen"
                               Symbol="ExitFullScreen"
                               Tip="{DynamicResource CaptionExitFullScreen}" />
              <c:CaptionButton Job="Close"
                               Classes="close"
                               Symbol="Close"
                               Tip="{DynamicResource CaptionClose}" />
            </StackPanel>
            <c:CaptionTip />
          </c:CaptionBar>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- It comes at once and goes slowly, like the buttons of the title bar. -->
    <Style Selector="^ /template/ c|CaptionBar#PART_FullScreenBar">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ c|CaptionBar#PART_FullScreenBar:resting">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.8" Easing="SineEaseInOut" />
        </Transitions>
      </Setter>
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- On the way to full screen and back the content steps out, and comes back in its new place. -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="SineEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^.changing /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
      <Setter Property="Opacity" Value="0" />
    </Style>
  </ControlTheme>

  <!-- The page in a browser. -->
  <ControlTheme x:Key="{x:Type EmbeddableControlRoot}" TargetType="EmbeddableControlRoot">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Background" Value="{DynamicResource Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" TextOptions.TextRenderingMode="Antialias" TextOptions.TextHintingMode="None">
          <VisualLayerManager Name="PART_VisualLayerManager">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </VisualLayerManager>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:CaptionButton}" TargetType="c:CaptionButton">
    <Setter Property="Width" Value="46" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="(WindowDecorationProperties.ElementRole)" Value="DecorationsElement" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <c:CaptionGlyph Symbol="{TemplateBinding Symbol}"
                          Width="10"
                          Height="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource InkGhost}" />
    </Style>
    <Style Selector="^.close:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentSevere}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentSevere}" />
    </Style>
    <Style Selector="^.close:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentSeverePressed}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:CaptionTip}" TargetType="c:CaptionTip">
    <Setter Property="Background" Value="{DynamicResource TipSurface}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TipInk}" />
    <Setter Property="TextElement.FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
    <Style Selector="^.shown">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <!--
    The window's frame where the app draws it. Windows keeps its own border, shadow and corners; the app draws the title bar with
    its buttons, connected to the window by their parts' names. Only the maximize button tells Windows what it is, for the snap
    layouts: over anything the hit test calls a window button, Windows shows a tip of its own beside ours.
  -->
  <ControlTheme x:Key="{x:Type WindowDrawnDecorations}" TargetType="WindowDrawnDecorations">
    <Setter Property="DefaultTitleBarHeight" Value="{StaticResource TitleBarHeight}" />
    <Setter Property="DefaultFrameThickness" Value="1" />
    <Setter Property="DefaultShadowThickness" Value="8" />
    <Setter Property="Template">
      <WindowDrawnDecorationsTemplate>
        <WindowDrawnDecorationsContent>

          <WindowDrawnDecorationsContent.Underlay>
            <Panel x:Name="PART_UnderlayWrapper">
              <Border x:Name="PART_WindowBorder"
                      BorderThickness="{TemplateBinding FrameThickness}"
                      BorderBrush="{DynamicResource Hairline}"
                      IsHitTestVisible="False" />
              <Panel x:Name="PART_TitleBar"
                     VerticalAlignment="Top"
                     Height="{TemplateBinding TitleBarHeight}"
                     Background="Transparent"
                     IsVisible="{TemplateBinding HasTitleBar}"
                     WindowDecorationProperties.ElementRole="TitleBar" />
            </Panel>
          </WindowDrawnDecorationsContent.Underlay>

          <WindowDrawnDecorationsContent.Overlay>
            <Panel x:Name="PART_OverlayWrapper"
                   TextElement.FontFamily="{DynamicResource UiFont}"
                   TextOptions.TextRenderingMode="Antialias"
                   TextOptions.TextHintingMode="None">
              <c:CaptionBar x:Name="PART_CaptionBar"
                            VerticalAlignment="Top"
                            Height="{TemplateBinding TitleBarHeight}"
                            IsVisible="{TemplateBinding HasTitleBar}">
                <TextBlock x:Name="PART_Title"
                           Text="{TemplateBinding Title}"
                           Foreground="{DynamicResource InkFaint}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="184,0"
                           IsHitTestVisible="False" />
                <StackPanel x:Name="PART_Buttons" Orientation="Horizontal" HorizontalAlignment="Right">
                  <c:CaptionButton x:Name="FullScreenButton"
                                   Job="ToggleFullScreen"
                                   Symbol="FullScreen"
                                   Tip="{DynamicResource CaptionFullScreen}" />
                  <c:CaptionButton x:Name="PART_MinimizeButton"
                                   Symbol="Minimize"
                                   Tip="{DynamicResource CaptionMinimize}" />
                  <!-- Windows opens its snap layouts here, just after our tip would come up. -->
                  <c:CaptionButton x:Name="PART_MaximizeButton"
                                   ShowsTip="{OnPlatform True, Windows=False}"
                                   WindowDecorationProperties.ElementRole="MaximizeButton" />
                  <c:CaptionButton x:Name="PART_CloseButton"
                                   Classes="close"
                                   Symbol="Close"
                                   Tip="{DynamicResource CaptionClose}" />
                </StackPanel>
                <c:CaptionTip />
              </c:CaptionBar>
            </Panel>
          </WindowDrawnDecorationsContent.Overlay>

        </WindowDrawnDecorationsContent>
      </WindowDrawnDecorationsTemplate>
    </Setter>

    <Style Selector="^ /template/ c|CaptionButton#PART_MaximizeButton">
      <Setter Property="Symbol" Value="Maximize" />
      <Setter Property="Tip" Value="{DynamicResource CaptionMaximize}" />
    </Style>
    <Style Selector="^:maximized /template/ c|CaptionButton#PART_MaximizeButton">
      <Setter Property="Symbol" Value="Restore" />
      <Setter Property="Tip" Value="{DynamicResource CaptionRestore}" />
    </Style>

    <!-- The window's buttons rest while the pointer is away from the bar: they come at once and go slowly. -->
    <Style Selector="^ /template/ StackPanel#PART_Buttons">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ c|CaptionBar:resting StackPanel#PART_Buttons">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.8" Easing="SineEaseInOut" />
        </Transitions>
      </Setter>
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- A window that is not the active one steps back. -->
    <Style Selector="^ /template/ c|CaptionBar:inactive TextBlock#PART_Title">
      <Setter Property="Foreground" Value="{DynamicResource InkGhost}" />
    </Style>
    <Style Selector="^ /template/ c|CaptionBar:inactive c|CaptionButton:not(:pointerover)">
      <Setter Property="Foreground" Value="{DynamicResource InkGhost}" />
    </Style>

    <!-- Where the platform leaves the frame to the app (Linux, for instance): a border and a shadow. -->
    <Style Selector="^:has-shadow /template/ Panel#PART_UnderlayWrapper">
      <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
    </Style>
    <Style Selector="^:has-shadow /template/ Border#PART_WindowBorder">
      <Setter Property="BoxShadow" Value="0 2 12 0 #40000000" />
    </Style>
    <Style Selector="^:has-shadow /template/ Panel#PART_OverlayWrapper">
      <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
    </Style>
    <Style Selector="^:has-border /template/ Panel#PART_TitleBar">
      <Setter Property="Margin" Value="1,1,1,0" />
    </Style>
    <Style Selector="^:has-border /template/ c|CaptionBar#PART_CaptionBar">
      <Setter Property="Margin" Value="1,1,1,0" />
    </Style>

    <Style Selector="^:not(:has-minimize) /template/ c|CaptionButton#PART_MinimizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-maximize) /template/ c|CaptionButton#PART_MaximizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-fullscreen) /template/ c|CaptionButton#FullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <!-- The pointer's wheel and gestures scroll it; it has no bars yet. -->
  <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <ScrollContentPresenter Name="PART_ContentPresenter"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
          <ScrollContentPresenter.GestureRecognizers>
            <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                     CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                     IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}"
                                     Offset="{Binding Offset, ElementName=PART_ContentPresenter}"
                                     Viewport="{Binding Viewport, ElementName=PART_ContentPresenter}"
                                     Extent="{Binding Extent, ElementName=PART_ContentPresenter}" />
          </ScrollContentPresenter.GestureRecognizers>
        </ScrollContentPresenter>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:DocumentView}" TargetType="c:DocumentView">
    <Setter Property="Sheet" Value="{DynamicResource Sheet}" />
    <Setter Property="SheetShadow" Value="{DynamicResource SheetShadow}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Selection}" />
    <Setter Property="MeaningBrush" Value="{DynamicResource InkGhost}" />
    <Setter Property="PointedBrush" Value="{DynamicResource Accent}" />
    <Setter Property="OnPointedBrush" Value="{DynamicResource OnAccent}" />
  </ControlTheme>

  <!-- A choice among few, written out: the chosen one stands out from the others. -->
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
  </ControlTheme>

  <!-- Something that is on or off, written out after a small switch: on, the switch is filled and its knob stands right. -->
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Border Name="PART_Track" Width="20" Height="11" CornerRadius="5.5" Background="{DynamicResource InkGhost}" VerticalAlignment="Center">
              <Ellipse Name="PART_Knob" Width="7" Height="7" Fill="{DynamicResource Sheet}" HorizontalAlignment="Left" Margin="2,0" />
            </Border>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Style Selector="^ /template/ Border#PART_Track">
        <Setter Property="Background" Value="{DynamicResource Ink}" />
      </Style>
      <Style Selector="^ /template/ Ellipse#PART_Knob">
        <Setter Property="HorizontalAlignment" Value="Right" />
      </Style>
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
