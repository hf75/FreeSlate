<!-- The light theme: every colour the editor shows. Another theme is a copy of this file with other values. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The surface everything lies on. -->
  <SolidColorBrush x:Key="Canvas" Color="#F8F7F4" />
  <SolidColorBrush x:Key="Hairline" Color="#E4E2DC" />

  <!-- Text and symbols, from most to least present. -->
  <SolidColorBrush x:Key="Ink" Color="#23221F" />
  <SolidColorBrush x:Key="InkSoft" Color="#4B4A46" />
  <SolidColorBrush x:Key="InkFaint" Color="#6F6D67" />
  <SolidColorBrush x:Key="InkGhost" Color="#A9A7A0" />

  <!--
    The accent, the app's only colour: a signal in the sense of Dieter Rams, colour only where it tells something. It marks what the
    pointer or the keyboard stands on: the lighter one for the everyday, the darker one for what has consequences, such as closing
    the window.
  -->
  <SolidColorBrush x:Key="Accent" Color="#F4B42A" />
  <SolidColorBrush x:Key="AccentPressed" Color="#E5A41C" />
  <SolidColorBrush x:Key="OnAccent" Color="#33260A" />
  <SolidColorBrush x:Key="AccentSevere" Color="#C8441A" />
  <SolidColorBrush x:Key="AccentSeverePressed" Color="#AD3A16" />
  <SolidColorBrush x:Key="OnAccentSevere" Color="#FFF8F2" />

  <!-- A tip beside the pointer. -->
  <SolidColorBrush x:Key="TipSurface" Color="#2C2B28" />
  <SolidColorBrush x:Key="TipInk" Color="#F8F7F4" />
</ResourceDictionary>
