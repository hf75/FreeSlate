<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Bending steps: many steps in rows across the page, each row going on from where the one above it ended (left to right,
     then right to left), an arrow from each step to the next; a step's subpoints listed in its box. FreeSlate's own definition
     (see SmartArts). -->
<dgm:layoutDef xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" uniqueId="urn:freeslate.app/smartart/layout/bending">
  <dgm:title val="Bending steps"/>
  <dgm:desc val="Many steps in rows, each row going on where the one above ended, an arrow between each step and the next."/>
  <dgm:catLst>
    <dgm:cat type="process" pri="600"/>
  </dgm:catLst>
  <dgm:layoutNode name="rows">
    <dgm:varLst>
      <dgm:resizeHandles val="exact"/>
    </dgm:varLst>
    <dgm:alg type="snake">
      <dgm:param type="grDir" val="tL"/>
      <dgm:param type="flowDir" val="row"/>
      <dgm:param type="contDir" val="revDir"/>
      <dgm:param type="bkpt" val="endCnv"/>
    </dgm:alg>
    <dgm:shape>
      <dgm:adjLst/>
    </dgm:shape>
    <dgm:presOf/>
    <dgm:constrLst>
      <dgm:constr type="w" for="ch" forName="stage" refType="w"/>
      <dgm:constr type="w" for="ch" forName="turn" refType="w" refFor="ch" refForName="stage" op="equ" fact="0.28"/>
      <dgm:constr type="sp" refType="w" refFor="ch" refForName="turn" op="equ"/>
      <dgm:constr type="primFontSz" for="ch" forName="stage" op="equ" val="15"/>
    </dgm:constrLst>
    <dgm:ruleLst/>
    <dgm:forEach name="stages" axis="ch" ptType="node">
      <dgm:layoutNode name="stage" styleLbl="node1">
        <dgm:varLst>
          <dgm:bulletEnabled val="1"/>
        </dgm:varLst>
        <dgm:alg type="tx"/>
        <dgm:shape type="roundRect">
          <dgm:adjLst>
            <dgm:adj idx="1" val="0.12"/>
          </dgm:adjLst>
        </dgm:shape>
        <dgm:presOf axis="desOrSelf" ptType="node"/>
        <dgm:constrLst>
          <dgm:constr type="h" refType="w" fact="0.6"/>
          <dgm:constr type="tMarg" refType="primFontSz" fact="0.35"/>
          <dgm:constr type="bMarg" refType="primFontSz" fact="0.35"/>
          <dgm:constr type="lMarg" refType="primFontSz" fact="0.45"/>
          <dgm:constr type="rMarg" refType="primFontSz" fact="0.45"/>
        </dgm:constrLst>
        <dgm:ruleLst>
          <dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/>
        </dgm:ruleLst>
      </dgm:layoutNode>
      <dgm:forEach name="turns" axis="followSib" ptType="sibTrans" cnt="1">
        <dgm:layoutNode name="turn" styleLbl="sibTrans2D1">
          <dgm:alg type="conn">
            <dgm:param type="begPts" val="auto"/>
            <dgm:param type="endPts" val="auto"/>
          </dgm:alg>
          <dgm:shape type="conn">
            <dgm:adjLst/>
          </dgm:shape>
          <dgm:presOf axis="self"/>
          <dgm:constrLst>
            <dgm:constr type="h" refType="w" fact="0.7"/>
            <dgm:constr type="connDist"/>
            <dgm:constr type="begPad" refType="connDist" fact="0.2"/>
            <dgm:constr type="endPad" refType="connDist" fact="0.2"/>
          </dgm:constrLst>
          <dgm:ruleLst/>
        </dgm:layoutNode>
      </dgm:forEach>
    </dgm:forEach>
  </dgm:layoutNode>
</dgm:layoutDef>
