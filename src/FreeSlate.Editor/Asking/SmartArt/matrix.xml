<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- A matrix: two to four points as the quadrants of a square, each with its text and its subpoints. FreeSlate's own definition (see
     SmartArts). -->
<dgm:layoutDef xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" uniqueId="urn:freeslate.app/smartart/layout/matrix">
  <dgm:title val="Matrix"/>
  <dgm:desc val="Four quadrants of a whole, two by two."/>
  <dgm:catLst>
    <dgm:cat type="matrix" pri="500"/>
  </dgm:catLst>
  <dgm:layoutNode name="matrix">
    <dgm:varLst>
      <dgm:chMax val="4"/>
      <dgm:resizeHandles val="exact"/>
    </dgm:varLst>
    <dgm:alg type="composite">
      <dgm:param type="ar" val="1.4"/>
    </dgm:alg>
    <dgm:shape>
      <dgm:adjLst/>
    </dgm:shape>
    <dgm:presOf/>
    <dgm:constrLst>
      <dgm:constr type="l" for="ch" forName="quadrant1"/>
      <dgm:constr type="t" for="ch" forName="quadrant1"/>
      <dgm:constr type="w" for="ch" forName="quadrant1" refType="w" fact="0.49"/>
      <dgm:constr type="h" for="ch" forName="quadrant1" refType="h" fact="0.49"/>
      <dgm:constr type="l" for="ch" forName="quadrant2" refType="w" fact="0.51"/>
      <dgm:constr type="t" for="ch" forName="quadrant2"/>
      <dgm:constr type="w" for="ch" forName="quadrant2" refType="w" fact="0.49"/>
      <dgm:constr type="h" for="ch" forName="quadrant2" refType="h" fact="0.49"/>
      <dgm:constr type="l" for="ch" forName="quadrant3"/>
      <dgm:constr type="t" for="ch" forName="quadrant3" refType="h" fact="0.51"/>
      <dgm:constr type="w" for="ch" forName="quadrant3" refType="w" fact="0.49"/>
      <dgm:constr type="h" for="ch" forName="quadrant3" refType="h" fact="0.49"/>
      <dgm:constr type="l" for="ch" forName="quadrant4" refType="w" fact="0.51"/>
      <dgm:constr type="t" for="ch" forName="quadrant4" refType="h" fact="0.51"/>
      <dgm:constr type="w" for="ch" forName="quadrant4" refType="w" fact="0.49"/>
      <dgm:constr type="h" for="ch" forName="quadrant4" refType="h" fact="0.49"/>
      <dgm:constr type="primFontSz" for="ch" ptType="node" op="equ" val="16"/>
    </dgm:constrLst>
    <dgm:ruleLst/>
    <dgm:forEach name="firstQuadrant" axis="ch" ptType="node" cnt="1">
      <dgm:layoutNode name="quadrant1" styleLbl="node1">
        <dgm:varLst>
          <dgm:bulletEnabled val="1"/>
        </dgm:varLst>
        <dgm:alg type="tx"/>
        <dgm:shape type="roundRect">
          <dgm:adjLst>
            <dgm:adj idx="1" val="0.08"/>
          </dgm:adjLst>
        </dgm:shape>
        <dgm:presOf axis="desOrSelf" ptType="node"/>
        <dgm:constrLst>
          <dgm:constr type="tMarg" refType="primFontSz" fact="0.45"/>
          <dgm:constr type="bMarg" refType="primFontSz" fact="0.45"/>
          <dgm:constr type="lMarg" refType="primFontSz" fact="0.55"/>
          <dgm:constr type="rMarg" refType="primFontSz" fact="0.55"/>
        </dgm:constrLst>
        <dgm:ruleLst>
          <dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/>
        </dgm:ruleLst>
      </dgm:layoutNode>
    </dgm:forEach>
    <dgm:forEach name="secondQuadrant" axis="ch" ptType="node" st="2" cnt="1">
      <dgm:layoutNode name="quadrant2" styleLbl="node1">
        <dgm:varLst>
          <dgm:bulletEnabled val="1"/>
        </dgm:varLst>
        <dgm:alg type="tx"/>
        <dgm:shape type="roundRect">
          <dgm:adjLst>
            <dgm:adj idx="1" val="0.08"/>
          </dgm:adjLst>
        </dgm:shape>
        <dgm:presOf axis="desOrSelf" ptType="node"/>
        <dgm:constrLst>
          <dgm:constr type="tMarg" refType="primFontSz" fact="0.45"/>
          <dgm:constr type="bMarg" refType="primFontSz" fact="0.45"/>
          <dgm:constr type="lMarg" refType="primFontSz" fact="0.55"/>
          <dgm:constr type="rMarg" refType="primFontSz" fact="0.55"/>
        </dgm:constrLst>
        <dgm:ruleLst>
          <dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/>
        </dgm:ruleLst>
      </dgm:layoutNode>
    </dgm:forEach>
    <dgm:forEach name="thirdQuadrant" axis="ch" ptType="node" st="3" cnt="1">
      <dgm:layoutNode name="quadrant3" styleLbl="node1">
        <dgm:varLst>
          <dgm:bulletEnabled val="1"/>
        </dgm:varLst>
        <dgm:alg type="tx"/>
        <dgm:shape type="roundRect">
          <dgm:adjLst>
            <dgm:adj idx="1" val="0.08"/>
          </dgm:adjLst>
        </dgm:shape>
        <dgm:presOf axis="desOrSelf" ptType="node"/>
        <dgm:constrLst>
          <dgm:constr type="tMarg" refType="primFontSz" fact="0.45"/>
          <dgm:constr type="bMarg" refType="primFontSz" fact="0.45"/>
          <dgm:constr type="lMarg" refType="primFontSz" fact="0.55"/>
          <dgm:constr type="rMarg" refType="primFontSz" fact="0.55"/>
        </dgm:constrLst>
        <dgm:ruleLst>
          <dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/>
        </dgm:ruleLst>
      </dgm:layoutNode>
    </dgm:forEach>
    <dgm:forEach name="fourthQuadrant" axis="ch" ptType="node" st="4" cnt="1">
      <dgm:layoutNode name="quadrant4" styleLbl="node1">
        <dgm:varLst>
          <dgm:bulletEnabled val="1"/>
        </dgm:varLst>
        <dgm:alg type="tx"/>
        <dgm:shape type="roundRect">
          <dgm:adjLst>
            <dgm:adj idx="1" val="0.08"/>
          </dgm:adjLst>
        </dgm:shape>
        <dgm:presOf axis="desOrSelf" ptType="node"/>
        <dgm:constrLst>
          <dgm:constr type="tMarg" refType="primFontSz" fact="0.45"/>
          <dgm:constr type="bMarg" refType="primFontSz" fact="0.45"/>
          <dgm:constr type="lMarg" refType="primFontSz" fact="0.55"/>
          <dgm:constr type="rMarg" refType="primFontSz" fact="0.55"/>
        </dgm:constrLst>
        <dgm:ruleLst>
          <dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/>
        </dgm:ruleLst>
      </dgm:layoutNode>
    </dgm:forEach>
  </dgm:layoutNode>
</dgm:layoutDef>
