<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Overlapping circles, one for each point (one to four): see-through, so that where they overlap is darker; each point's text in
     the part of its circle the others leave free. FreeSlate's own definition (see SmartArts). With branches for more points (circles on
     a ring) Word took the definition for none (measured), so there are none. -->
<dgm:layoutDef xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" uniqueId="urn:freeslate.app/smartart/layout/venn">
  <dgm:title val="Overlap"/>
  <dgm:desc val="Overlapping circles, for what several things share."/>
  <dgm:catLst>
    <dgm:cat type="relationship" pri="500"/>
  </dgm:catLst>
  <dgm:layoutNode name="venn">
    <dgm:varLst>
      <dgm:chMax val="4"/>
      <dgm:resizeHandles val="exact"/>
    </dgm:varLst>
    <dgm:choose name="shape">
      <dgm:if name="two" axis="ch" ptType="node" func="cnt" op="equ" val="2">
        <dgm:alg type="composite">
          <dgm:param type="ar" val="1.7"/>
        </dgm:alg>
      </dgm:if>
      <dgm:else name="threeOrFour">
        <dgm:alg type="composite">
          <dgm:param type="ar" val="1"/>
        </dgm:alg>
      </dgm:else>
    </dgm:choose>
    <dgm:shape>
      <dgm:adjLst/>
    </dgm:shape>
    <dgm:presOf/>
    <dgm:choose name="places">
      <dgm:if name="one" axis="ch" ptType="node" func="cnt" op="equ" val="1">
        <dgm:constrLst>
          <dgm:constr type="ctrX" for="ch" forName="circle1" refType="w" fact="0.5"/>
          <dgm:constr type="ctrY" for="ch" forName="circle1" refType="h" fact="0.5"/>
          <dgm:constr type="w" for="ch" forName="circle1" refType="w"/>
          <dgm:constr type="h" for="ch" forName="circle1" refType="h"/>
          <dgm:constr type="l" for="ch" forName="text1" refType="w" fact="0.18"/>
          <dgm:constr type="t" for="ch" forName="text1" refType="h" fact="0.18"/>
          <dgm:constr type="w" for="ch" forName="text1" refType="w" fact="0.64"/>
          <dgm:constr type="h" for="ch" forName="text1" refType="h" fact="0.64"/>
          <dgm:constr type="primFontSz" for="ch" ptType="node" op="equ" val="16"/>
        </dgm:constrLst>
      </dgm:if>
      <dgm:if name="two2" axis="ch" ptType="node" func="cnt" op="equ" val="2">
        <dgm:constrLst>
          <dgm:constr type="ctrX" for="ch" forName="circle1" refType="w" fact="0.31"/>
          <dgm:constr type="ctrY" for="ch" forName="circle1" refType="h" fact="0.5"/>
          <dgm:constr type="w" for="ch" forName="circle1" refType="w" fact="0.58"/>
          <dgm:constr type="h" for="ch" forName="circle1" refType="h" fact="0.986"/>
          <dgm:constr type="l" for="ch" forName="text1" refType="w" fact="0.07"/>
          <dgm:constr type="t" for="ch" forName="text1" refType="h" fact="0.2"/>
          <dgm:constr type="w" for="ch" forName="text1" refType="w" fact="0.3"/>
          <dgm:constr type="h" for="ch" forName="text1" refType="h" fact="0.6"/>
          <dgm:constr type="ctrX" for="ch" forName="circle2" refType="w" fact="0.69"/>
          <dgm:constr type="ctrY" for="ch" forName="circle2" refType="h" fact="0.5"/>
          <dgm:constr type="w" for="ch" forName="circle2" refType="w" fact="0.58"/>
          <dgm:constr type="h" for="ch" forName="circle2" refType="h" fact="0.986"/>
          <dgm:constr type="l" for="ch" forName="text2" refType="w" fact="0.63"/>
          <dgm:constr type="t" for="ch" forName="text2" refType="h" fact="0.2"/>
          <dgm:constr type="w" for="ch" forName="text2" refType="w" fact="0.3"/>
          <dgm:constr type="h" for="ch" forName="text2" refType="h" fact="0.6"/>
          <dgm:constr type="primFontSz" for="ch" ptType="node" op="equ" val="16"/>
        </dgm:constrLst>
      </dgm:if>
      <dgm:if name="three" axis="ch" ptType="node" func="cnt" op="equ" val="3">
        <dgm:constrLst>
          <dgm:constr type="ctrX" for="ch" forName="circle1" refType="w" fact="0.5"/>
          <dgm:constr type="ctrY" for="ch" forName="circle1" refType="h" fact="0.336"/>
          <dgm:constr type="w" for="ch" forName="circle1" refType="w" fact="0.58"/>
          <dgm:constr type="h" for="ch" forName="circle1" refType="h" fact="0.58"/>
          <dgm:constr type="l" for="ch" forName="text1" refType="w" fact="0.29"/>
          <dgm:constr type="t" for="ch" forName="text1" refType="h" fact="0.1"/>
          <dgm:constr type="w" for="ch" forName="text1" refType="w" fact="0.42"/>
          <dgm:constr type="h" for="ch" forName="text1" refType="h" fact="0.22"/>
          <dgm:constr type="ctrX" for="ch" forName="circle2" refType="w" fact="0.69"/>
          <dgm:constr type="ctrY" for="ch" forName="circle2" refType="h" fact="0.665"/>
          <dgm:constr type="w" for="ch" forName="circle2" refType="w" fact="0.58"/>
          <dgm:constr type="h" for="ch" forName="circle2" refType="h" fact="0.58"/>
          <dgm:constr type="l" for="ch" forName="text2" refType="w" fact="0.62"/>
          <dgm:constr type="t" for="ch" forName="text2" refType="h" fact="0.6"/>
          <dgm:constr type="w" for="ch" forName="text2" refType="w" fact="0.32"/>
          <dgm:constr type="h" for="ch" forName="text2" refType="h" fact="0.27"/>
          <dgm:constr type="ctrX" for="ch" forName="circle3" refType="w" fact="0.31"/>
          <dgm:constr type="ctrY" for="ch" forName="circle3" refType="h" fact="0.665"/>
          <dgm:constr type="w" for="ch" forName="circle3" refType="w" fact="0.58"/>
          <dgm:constr type="h" for="ch" forName="circle3" refType="h" fact="0.58"/>
          <dgm:constr type="l" for="ch" forName="text3" refType="w" fact="0.06"/>
          <dgm:constr type="t" for="ch" forName="text3" refType="h" fact="0.6"/>
          <dgm:constr type="w" for="ch" forName="text3" refType="w" fact="0.32"/>
          <dgm:constr type="h" for="ch" forName="text3" refType="h" fact="0.27"/>
          <dgm:constr type="primFontSz" for="ch" ptType="node" op="equ" val="15"/>
        </dgm:constrLst>
      </dgm:if>
      <dgm:if name="four" axis="ch" ptType="node" func="cnt" op="equ" val="4">
        <dgm:constrLst>
          <dgm:constr type="ctrX" for="ch" forName="circle1" refType="w" fact="0.36"/>
          <dgm:constr type="ctrY" for="ch" forName="circle1" refType="h" fact="0.36"/>
          <dgm:constr type="w" for="ch" forName="circle1" refType="w" fact="0.54"/>
          <dgm:constr type="h" for="ch" forName="circle1" refType="h" fact="0.54"/>
          <dgm:constr type="l" for="ch" forName="text1" refType="w" fact="0.12"/>
          <dgm:constr type="t" for="ch" forName="text1" refType="h" fact="0.17"/>
          <dgm:constr type="w" for="ch" forName="text1" refType="w" fact="0.3"/>
          <dgm:constr type="h" for="ch" forName="text1" refType="h" fact="0.2"/>
          <dgm:constr type="ctrX" for="ch" forName="circle2" refType="w" fact="0.64"/>
          <dgm:constr type="ctrY" for="ch" forName="circle2" refType="h" fact="0.36"/>
          <dgm:constr type="w" for="ch" forName="circle2" refType="w" fact="0.54"/>
          <dgm:constr type="h" for="ch" forName="circle2" refType="h" fact="0.54"/>
          <dgm:constr type="l" for="ch" forName="text2" refType="w" fact="0.58"/>
          <dgm:constr type="t" for="ch" forName="text2" refType="h" fact="0.17"/>
          <dgm:constr type="w" for="ch" forName="text2" refType="w" fact="0.3"/>
          <dgm:constr type="h" for="ch" forName="text2" refType="h" fact="0.2"/>
          <dgm:constr type="ctrX" for="ch" forName="circle3" refType="w" fact="0.64"/>
          <dgm:constr type="ctrY" for="ch" forName="circle3" refType="h" fact="0.64"/>
          <dgm:constr type="w" for="ch" forName="circle3" refType="w" fact="0.54"/>
          <dgm:constr type="h" for="ch" forName="circle3" refType="h" fact="0.54"/>
          <dgm:constr type="l" for="ch" forName="text3" refType="w" fact="0.58"/>
          <dgm:constr type="t" for="ch" forName="text3" refType="h" fact="0.63"/>
          <dgm:constr type="w" for="ch" forName="text3" refType="w" fact="0.3"/>
          <dgm:constr type="h" for="ch" forName="text3" refType="h" fact="0.2"/>
          <dgm:constr type="ctrX" for="ch" forName="circle4" refType="w" fact="0.36"/>
          <dgm:constr type="ctrY" for="ch" forName="circle4" refType="h" fact="0.64"/>
          <dgm:constr type="w" for="ch" forName="circle4" refType="w" fact="0.54"/>
          <dgm:constr type="h" for="ch" forName="circle4" refType="h" fact="0.54"/>
          <dgm:constr type="l" for="ch" forName="text4" refType="w" fact="0.12"/>
          <dgm:constr type="t" for="ch" forName="text4" refType="h" fact="0.63"/>
          <dgm:constr type="w" for="ch" forName="text4" refType="w" fact="0.3"/>
          <dgm:constr type="h" for="ch" forName="text4" refType="h" fact="0.2"/>
          <dgm:constr type="primFontSz" for="ch" ptType="node" op="equ" val="14"/>
        </dgm:constrLst>
      </dgm:if>
    </dgm:choose>
    <dgm:ruleLst/>
      
        <dgm:forEach name="first" axis="ch" ptType="node" cnt="1">
          <dgm:layoutNode name="circle1" styleLbl="vennNode1">
            <dgm:alg type="sp"/>
            <dgm:shape type="ellipse">
              <dgm:adjLst/>
            </dgm:shape>
            <dgm:presOf axis="desOrSelf" ptType="node"/>
            <dgm:constrLst/>
            <dgm:ruleLst/>
          </dgm:layoutNode>
          <dgm:layoutNode name="text1" styleLbl="revTx">
            <dgm:varLst>
              <dgm:bulletEnabled val="1"/>
            </dgm:varLst>
            <dgm:alg type="tx"/>
            <dgm:shape type="rect" hideGeom="1">
              <dgm:adjLst/>
            </dgm:shape>
            <dgm:presOf axis="desOrSelf" ptType="node"/>
            <dgm:constrLst>
              <dgm:constr type="lMarg"/>
              <dgm:constr type="rMarg"/>
              <dgm:constr type="tMarg"/>
              <dgm:constr type="bMarg"/>
            </dgm:constrLst>
            <dgm:ruleLst>
              <dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/>
            </dgm:ruleLst>
          </dgm:layoutNode>
        </dgm:forEach>
        <dgm:forEach name="second" axis="ch" ptType="node" st="2" cnt="1">
          <dgm:layoutNode name="circle2" styleLbl="vennNode1">
            <dgm:alg type="sp"/>
            <dgm:shape type="ellipse">
              <dgm:adjLst/>
            </dgm:shape>
            <dgm:presOf axis="desOrSelf" ptType="node"/>
            <dgm:constrLst/>
            <dgm:ruleLst/>
          </dgm:layoutNode>
          <dgm:layoutNode name="text2" styleLbl="revTx">
            <dgm:varLst>
              <dgm:bulletEnabled val="1"/>
            </dgm:varLst>
            <dgm:alg type="tx"/>
            <dgm:shape type="rect" hideGeom="1">
              <dgm:adjLst/>
            </dgm:shape>
            <dgm:presOf axis="desOrSelf" ptType="node"/>
            <dgm:constrLst>
              <dgm:constr type="lMarg"/>
              <dgm:constr type="rMarg"/>
              <dgm:constr type="tMarg"/>
              <dgm:constr type="bMarg"/>
            </dgm:constrLst>
            <dgm:ruleLst>
              <dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/>
            </dgm:ruleLst>
          </dgm:layoutNode>
        </dgm:forEach>
        <dgm:forEach name="third" axis="ch" ptType="node" st="3" cnt="1">
          <dgm:layoutNode name="circle3" styleLbl="vennNode1">
            <dgm:alg type="sp"/>
            <dgm:shape type="ellipse">
              <dgm:adjLst/>
            </dgm:shape>
            <dgm:presOf axis="desOrSelf" ptType="node"/>
            <dgm:constrLst/>
            <dgm:ruleLst/>
          </dgm:layoutNode>
          <dgm:layoutNode name="text3" styleLbl="revTx">
            <dgm:varLst>
              <dgm:bulletEnabled val="1"/>
            </dgm:varLst>
            <dgm:alg type="tx"/>
            <dgm:shape type="rect" hideGeom="1">
              <dgm:adjLst/>
            </dgm:shape>
            <dgm:presOf axis="desOrSelf" ptType="node"/>
            <dgm:constrLst>
              <dgm:constr type="lMarg"/>
              <dgm:constr type="rMarg"/>
              <dgm:constr type="tMarg"/>
              <dgm:constr type="bMarg"/>
            </dgm:constrLst>
            <dgm:ruleLst>
              <dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/>
            </dgm:ruleLst>
          </dgm:layoutNode>
        </dgm:forEach>
        <dgm:forEach name="fourth" axis="ch" ptType="node" st="4" cnt="1">
          <dgm:layoutNode name="circle4" styleLbl="vennNode1">
            <dgm:alg type="sp"/>
            <dgm:shape type="ellipse">
              <dgm:adjLst/>
            </dgm:shape>
            <dgm:presOf axis="desOrSelf" ptType="node"/>
            <dgm:constrLst/>
            <dgm:ruleLst/>
          </dgm:layoutNode>
          <dgm:layoutNode name="text4" styleLbl="revTx">
            <dgm:varLst>
              <dgm:bulletEnabled val="1"/>
            </dgm:varLst>
            <dgm:alg type="tx"/>
            <dgm:shape type="rect" hideGeom="1">
              <dgm:adjLst/>
            </dgm:shape>
            <dgm:presOf axis="desOrSelf" ptType="node"/>
            <dgm:constrLst>
              <dgm:constr type="lMarg"/>
              <dgm:constr type="rMarg"/>
              <dgm:constr type="tMarg"/>
              <dgm:constr type="bMarg"/>
            </dgm:constrLst>
            <dgm:ruleLst>
              <dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/>
            </dgm:ruleLst>
          </dgm:layoutNode>
        </dgm:forEach>
  </dgm:layoutNode>
</dgm:layoutDef>
