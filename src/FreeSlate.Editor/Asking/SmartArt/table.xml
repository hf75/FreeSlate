<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- A table: the first point a header across the top, the others columns under it, each its text in a box and its subpoints in a cell below. FreeSlate's own definition (see SmartArts). -->
<dgm:layoutDef xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" uniqueId="urn:freeslate.app/smartart/layout/table">
  <dgm:title val="Table"/>
  <dgm:desc val="A heading over columns, each with its own heading and what belongs to it."/>
  <dgm:catLst>
    <dgm:cat type="list" pri="650"/>
    <dgm:cat type="hierarchy" pri="900"/>
  </dgm:catLst>
  <dgm:layoutNode name="table">
    <dgm:varLst>
      <dgm:resizeHandles val="exact"/>
    </dgm:varLst>
    <dgm:alg type="composite"/>
    <dgm:shape><dgm:adjLst/></dgm:shape>
    <dgm:presOf/>
    <dgm:choose name="headerHeight">
      <dgm:if name="headerAlone" axis="ch" ptType="node" func="cnt" op="equ" val="1"><dgm:constrLst><dgm:constr type="l" for="ch" forName="header" refType="w" fact="0"/><dgm:constr type="t" for="ch" forName="header" refType="h" fact="0"/><dgm:constr type="w" for="ch" forName="header" refType="w" fact="1"/><dgm:constr type="h" for="ch" forName="header" refType="h" fact="1"/><dgm:constr type="l" for="ch" forName="columns" refType="w" fact="0"/><dgm:constr type="t" for="ch" forName="columns" refType="h" fact="0"/><dgm:constr type="w" for="ch" forName="columns" refType="w" fact="1"/><dgm:constr type="h" for="ch" forName="columns" refType="h" fact="1"/><dgm:constr type="primFontSz" for="des" forName="header" op="equ" val="16"/><dgm:constr type="primFontSz" for="des" forName="heading" op="equ" val="14"/><dgm:constr type="primFontSz" for="des" forName="cells" op="equ" val="15"/></dgm:constrLst></dgm:if>
      <dgm:if name="headerDetailed" axis="ch ch" ptType="node node" st="1 1" cnt="1 0" func="cnt" op="gte" val="1"><dgm:constrLst><dgm:constr type="l" for="ch" forName="header" refType="w" fact="0"/><dgm:constr type="t" for="ch" forName="header" refType="h" fact="0"/><dgm:constr type="w" for="ch" forName="header" refType="w" fact="1"/><dgm:constr type="h" for="ch" forName="header" refType="h" fact="0.27"/><dgm:constr type="l" for="ch" forName="columns" refType="w" fact="0"/><dgm:constr type="t" for="ch" forName="columns" refType="h" fact="0.295"/><dgm:constr type="w" for="ch" forName="columns" refType="w" fact="1"/><dgm:constr type="h" for="ch" forName="columns" refType="h" fact="0.705"/><dgm:constr type="primFontSz" for="des" forName="header" op="equ" val="16"/><dgm:constr type="primFontSz" for="des" forName="heading" op="equ" val="14"/><dgm:constr type="primFontSz" for="des" forName="cells" op="equ" val="15"/></dgm:constrLst></dgm:if>
      <dgm:else name="headerPlain"><dgm:constrLst><dgm:constr type="l" for="ch" forName="header" refType="w" fact="0"/><dgm:constr type="t" for="ch" forName="header" refType="h" fact="0"/><dgm:constr type="w" for="ch" forName="header" refType="w" fact="1"/><dgm:constr type="h" for="ch" forName="header" refType="h" fact="0.2"/><dgm:constr type="l" for="ch" forName="columns" refType="w" fact="0"/><dgm:constr type="t" for="ch" forName="columns" refType="h" fact="0.225"/><dgm:constr type="w" for="ch" forName="columns" refType="w" fact="1"/><dgm:constr type="h" for="ch" forName="columns" refType="h" fact="0.775"/><dgm:constr type="primFontSz" for="des" forName="header" op="equ" val="16"/><dgm:constr type="primFontSz" for="des" forName="heading" op="equ" val="14"/><dgm:constr type="primFontSz" for="des" forName="cells" op="equ" val="15"/></dgm:constrLst></dgm:else>
    </dgm:choose>
    <dgm:ruleLst/>
    <dgm:forEach name="headerPoint" axis="ch" ptType="node" cnt="1">
      <dgm:layoutNode name="header" styleLbl="node0">
        <dgm:varLst>
          <dgm:bulletEnabled val="1"/>
        </dgm:varLst>
        <dgm:alg type="tx"><dgm:param type="txAnchorVert" val="mid"/><dgm:param type="txAnchorVertCh" val="mid"/><dgm:param type="parTxLTRAlign" val="ctr"/><dgm:param type="shpTxLTRAlignCh" val="ctr"/></dgm:alg>
        <dgm:shape type="round2SameRect"><dgm:adjLst><dgm:adj idx="1" val="0.16"/><dgm:adj idx="2" val="0"/></dgm:adjLst></dgm:shape>
        <dgm:presOf axis="desOrSelf" ptType="node"/>
        <dgm:constrLst><dgm:constr type="tMarg" refType="primFontSz" fact="0.25"/><dgm:constr type="bMarg" refType="primFontSz" fact="0.25"/><dgm:constr type="lMarg" refType="primFontSz" fact="0.5"/><dgm:constr type="rMarg" refType="primFontSz" fact="0.5"/></dgm:constrLst>
        <dgm:ruleLst><dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/></dgm:ruleLst>
      </dgm:layoutNode>
    </dgm:forEach>
    <dgm:layoutNode name="columns">
      <dgm:alg type="lin"/>
      <dgm:shape><dgm:adjLst/></dgm:shape>
      <dgm:presOf/>
      <dgm:constrLst><dgm:constr type="w" for="ch" forName="column" refType="w"/><dgm:constr type="h" for="ch" forName="column" refType="h"/><dgm:constr type="w" for="ch" forName="space" refType="w" refFor="ch" refForName="column" fact="0.035"/></dgm:constrLst>
      <dgm:ruleLst/>
      <dgm:forEach name="columnPoints" axis="ch" ptType="node" st="2">
        <dgm:layoutNode name="column">
          <dgm:alg type="composite"/>
          <dgm:shape><dgm:adjLst/></dgm:shape>
          <dgm:presOf/>
          <dgm:choose name="cellsOrNot">
            <dgm:if name="withCells" axis="par ch ch" ptType="doc node node" st="1 2 1" func="cnt" op="gte" val="1"><dgm:constrLst><dgm:constr type="l" for="ch" forName="heading" refType="w" fact="0"/><dgm:constr type="t" for="ch" forName="heading" refType="h" fact="0"/><dgm:constr type="w" for="ch" forName="heading" refType="w" fact="1"/><dgm:constr type="h" for="ch" forName="heading" refType="h" fact="0.2"/><dgm:constr type="l" for="ch" forName="cells" refType="w" fact="0"/><dgm:constr type="t" for="ch" forName="cells" refType="h" fact="0.215"/><dgm:constr type="w" for="ch" forName="cells" refType="w" fact="1"/><dgm:constr type="h" for="ch" forName="cells" refType="h" fact="0.785"/></dgm:constrLst></dgm:if>
            <dgm:else name="withoutCells"><dgm:constrLst><dgm:constr type="l" for="ch" forName="heading" refType="w" fact="0"/><dgm:constr type="t" for="ch" forName="heading" refType="h" fact="0"/><dgm:constr type="w" for="ch" forName="heading" refType="w" fact="1"/><dgm:constr type="h" for="ch" forName="heading" refType="h" fact="1"/></dgm:constrLst></dgm:else>
          </dgm:choose>
          <dgm:ruleLst/>
          <dgm:layoutNode name="heading" styleLbl="node1">
            <dgm:varLst>
              <dgm:bulletEnabled val="1"/>
            </dgm:varLst>
            <dgm:alg type="tx"><dgm:param type="txAnchorVert" val="mid"/><dgm:param type="parTxLTRAlign" val="ctr"/></dgm:alg>
            <dgm:shape type="rect"><dgm:adjLst></dgm:adjLst></dgm:shape>
            <dgm:presOf axis="self"/>
            <dgm:constrLst><dgm:constr type="tMarg" refType="primFontSz" fact="0.25"/><dgm:constr type="bMarg" refType="primFontSz" fact="0.25"/><dgm:constr type="lMarg" refType="primFontSz" fact="0.3"/><dgm:constr type="rMarg" refType="primFontSz" fact="0.3"/></dgm:constrLst>
            <dgm:ruleLst><dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/></dgm:ruleLst>
          </dgm:layoutNode>
          <dgm:choose name="cellNode">
            <dgm:if name="cellShown" axis="par ch ch" ptType="doc node node" st="1 2 1" func="cnt" op="gte" val="1">
              <dgm:layoutNode name="cells" styleLbl="sibTrans2D1">
                <dgm:varLst>
                  <dgm:bulletEnabled val="1"/>
                </dgm:varLst>
                <dgm:alg type="tx"><dgm:param type="stBulletLvl" val="1"/><dgm:param type="txAnchorVertCh" val="t"/></dgm:alg>
                <dgm:shape type="round2SameRect"><dgm:adjLst><dgm:adj idx="1" val="0"/><dgm:adj idx="2" val="0.1"/></dgm:adjLst></dgm:shape>
                <dgm:presOf axis="des" ptType="node"/>
                <dgm:constrLst><dgm:constr type="tMarg" refType="primFontSz" fact="0.4"/><dgm:constr type="bMarg" refType="primFontSz" fact="0.3"/><dgm:constr type="lMarg" refType="primFontSz" fact="0.3"/><dgm:constr type="rMarg" refType="primFontSz" fact="0.3"/></dgm:constrLst>
                <dgm:ruleLst><dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/></dgm:ruleLst>
              </dgm:layoutNode>
            </dgm:if>
            <dgm:else name="cellLeftOut"/>
          </dgm:choose>
        </dgm:layoutNode>
        <dgm:forEach name="between" axis="followSib" ptType="sibTrans" cnt="1">
          <dgm:layoutNode name="space">
            <dgm:alg type="sp"/>
            <dgm:shape><dgm:adjLst></dgm:adjLst></dgm:shape>
            <dgm:presOf/>
            <dgm:constrLst></dgm:constrLst>
            <dgm:ruleLst/>
          </dgm:layoutNode>
        </dgm:forEach>
      </dgm:forEach>
    </dgm:layoutNode>
  </dgm:layoutNode>
</dgm:layoutDef>
