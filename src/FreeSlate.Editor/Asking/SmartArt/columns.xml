<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Columns: the points side by side, each a heading bar over a light panel that lists its subpoints. FreeSlate's own definition (see
     SmartArts). -->
<dgm:layoutDef xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" uniqueId="urn:freeslate.app/smartart/layout/columns">
  <dgm:title val="Columns"/>
  <dgm:desc val="Points side by side, what belongs to each listed under its heading."/>
  <dgm:catLst>
    <dgm:cat type="list" pri="450"/>
  </dgm:catLst>
  <dgm:layoutNode name="columns">
    <dgm:varLst>
      <dgm:resizeHandles val="exact"/>
    </dgm:varLst>
    <dgm:alg type="lin"/>
    <dgm:shape>
      <dgm:adjLst/>
    </dgm:shape>
    <dgm:presOf/>
    <dgm:constrLst>
      <dgm:constr type="w" for="ch" forName="column" refType="w"/>
      <dgm:constr type="h" for="ch" forName="column" refType="h"/>
      <dgm:constr type="w" for="ch" forName="space" refType="w" refFor="ch" refForName="column" fact="0.05"/>
      <dgm:constr type="primFontSz" for="des" forName="heading" op="equ" val="15"/>
      <dgm:constr type="primFontSz" for="des" forName="panel" op="equ" val="13"/>
    </dgm:constrLst>
    <dgm:ruleLst/>
    <dgm:forEach name="all" axis="ch" ptType="node">
      <dgm:layoutNode name="column">
        <dgm:alg type="composite"/>
        <dgm:shape>
          <dgm:adjLst/>
        </dgm:shape>
        <dgm:presOf/>
        <dgm:constrLst>
          <dgm:constr type="l" for="ch" forName="heading"/>
          <dgm:constr type="t" for="ch" forName="heading"/>
          <dgm:constr type="w" for="ch" forName="heading" refType="w"/>
          <dgm:constr type="h" for="ch" forName="heading" refType="h" fact="0.22"/>
          <dgm:constr type="l" for="ch" forName="panel"/>
          <dgm:constr type="t" for="ch" forName="panel" refType="h" fact="0.22"/>
          <dgm:constr type="w" for="ch" forName="panel" refType="w"/>
          <dgm:constr type="h" for="ch" forName="panel" refType="h" fact="0.78"/>
        </dgm:constrLst>
        <dgm:ruleLst/>
        <dgm:layoutNode name="heading" styleLbl="node1">
          <dgm:varLst>
            <dgm:chMax val="0"/>
            <dgm:bulletEnabled val="1"/>
          </dgm:varLst>
          <dgm:alg type="tx"/>
          <dgm:shape type="round2SameRect">
            <dgm:adjLst>
              <dgm:adj idx="1" val="0.18"/>
              <dgm:adj idx="2" val="0"/>
            </dgm:adjLst>
          </dgm:shape>
          <dgm:presOf axis="self"/>
          <dgm:constrLst>
            <dgm:constr type="tMarg" refType="primFontSz" fact="0.25"/>
            <dgm:constr type="bMarg" refType="primFontSz" fact="0.25"/>
            <dgm:constr type="lMarg" refType="primFontSz" fact="0.4"/>
            <dgm:constr type="rMarg" refType="primFontSz" fact="0.4"/>
          </dgm:constrLst>
          <dgm:ruleLst>
            <dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/>
          </dgm:ruleLst>
        </dgm:layoutNode>
        <dgm:layoutNode name="panel" styleLbl="alignAcc1">
          <dgm:varLst>
            <dgm:bulletEnabled val="1"/>
          </dgm:varLst>
          <dgm:alg type="tx">
            <dgm:param type="stBulletLvl" val="1"/>
            <dgm:param type="txAnchorVertCh" val="t"/>
          </dgm:alg>
          <dgm:shape type="rect">
            <dgm:adjLst/>
          </dgm:shape>
          <dgm:presOf axis="des" ptType="node"/>
          <dgm:constrLst>
            <dgm:constr type="tMarg" refType="primFontSz" fact="0.45"/>
            <dgm:constr type="bMarg" refType="primFontSz" fact="0.3"/>
            <dgm:constr type="lMarg" refType="primFontSz" fact="0.4"/>
            <dgm:constr type="rMarg" refType="primFontSz" fact="0.3"/>
          </dgm:constrLst>
          <dgm:ruleLst>
            <dgm:rule type="primFontSz" val="7" fact="NaN" max="NaN"/>
          </dgm:ruleLst>
        </dgm:layoutNode>
      </dgm:layoutNode>
      <dgm:forEach name="between" axis="followSib" ptType="sibTrans" cnt="1">
        <dgm:layoutNode name="space">
          <dgm:alg type="sp"/>
          <dgm:shape>
            <dgm:adjLst/>
          </dgm:shape>
          <dgm:presOf/>
          <dgm:constrLst/>
          <dgm:ruleLst/>
        </dgm:layoutNode>
      </dgm:forEach>
    </dgm:forEach>
  </dgm:layoutNode>
</dgm:layoutDef>
