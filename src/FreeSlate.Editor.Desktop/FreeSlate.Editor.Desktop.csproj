<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\FreeSlate.Editor\Assets\FreeSlate.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <!-- Anthropic's SDK serializes by reflection, which PublishAot switches off in every build, dotnet run's too: the editor run so, not
         published, keeps it, so that Claude works there (the build compiled ahead of time has no such reflection). -->
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(_IsPublishing)' != 'true'">true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.12.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shelf's fonts beside the program, read when a document first needs them (EngineFonts). -->
    <None Include="..\FreeSlate.Editor\Fonts\**\*.ttf;..\FreeSlate.Editor\Fonts\**\*.txt" Link="Fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreeSlate.Editor\FreeSlate.Editor.csproj" />
  </ItemGroup>

</Project>
