<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FreeSlate</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.xml" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\*.js" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\*.bin" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\hyph-*.gz" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp" Version="14.2.1.301" />
  </ItemGroup>

</Project>
