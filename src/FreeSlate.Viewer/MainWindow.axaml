<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FreeSlate.Viewer"
        x:Class="FreeSlate.Viewer.MainWindow"
        Title="FreeSlate Viewer"
        Width="1280" Height="900" MinWidth="720" MinHeight="400">
  <DockPanel>
    <Border Name="Toolbar" DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <WrapPanel.Styles>
          <Style Selector="WrapPanel > :is(Control)">
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </WrapPanel.Styles>
        <Button Name="OpenButton" Content="Datei öffnen …" Click="OnOpenClick" ToolTip.Tip="Strg+O" />
        <Button Name="ReloadButton" Content="Neu laden" IsEnabled="False" Click="OnReloadClick" ToolTip.Tip="F5" />
        <ToggleButton Name="MarkupToggle" Content="Mit Markup" IsCheckedChanged="OnMarkupChanged"
                      ToolTip.Tip="Kommentare und Änderungen, wie Word sie mit Markup druckt" />
        <ToggleButton Name="BrowserToggle" Content="Browser" IsCheckedChanged="OnBrowserChanged"
                      ToolTip.Tip="Das Dokument als HTML im Browser zeigen statt die Seiten selbst mit Skia zu zeichnen" />
        <ComboBox Name="ZoomBox" MinWidth="140" SelectionChanged="OnZoomChanged" ToolTip.Tip="Zoom">
          <ComboBoxItem Content="Automatisch" />
          <ComboBoxItem Content="Seitenbreite" />
          <ComboBoxItem Content="Ganze Seite" />
          <ComboBoxItem Content="50 %" />
          <ComboBoxItem Content="75 %" />
          <ComboBoxItem Content="100 %" />
          <ComboBoxItem Content="125 %" />
          <ComboBoxItem Content="150 %" />
          <ComboBoxItem Content="200 %" />
        </ComboBox>
        <ComboBox Name="CompareBox" MinWidth="170" SelectionChanged="OnCompareChanged"
                  ToolTip.Tip="Words eigene Seiten zum Vergleich: Word druckt das Dokument als PDF">
          <ComboBoxItem Content="Ohne Word" />
          <ComboBoxItem Content="Word daneben" />
          <ComboBoxItem Content="Word überblendet" />
          <ComboBoxItem Content="Unterschiede" />
        </ComboBox>
        <Slider Name="BlendSlider" Minimum="0" Maximum="100" Width="140" IsVisible="False"
                ValueChanged="OnBlendChanged" ToolTip.Tip="Links FreeSlate, rechts Word" />
        <Button Name="PrintButton" Content="Drucken …" IsEnabled="False" Click="OnPrintClick" ToolTip.Tip="Strg+P" />
        <Button Name="SaveButton" Content="Als HTML speichern …" IsEnabled="False" Click="OnSaveClick" />
        <Button Name="PdfButton" Content="Als PDF speichern …" IsEnabled="False" Click="OnPdfClick" />
        <CheckBox Name="WatchBox" Content="Bei Änderung neu laden" IsCheckedChanged="OnWatchChanged"
                  ToolTip.Tip="Lädt das Dokument neu, sobald es gespeichert wird" />
        <StackPanel Name="PasswordPanel" Orientation="Horizontal" Spacing="8" IsVisible="False">
          <TextBox Name="PasswordBox" PasswordChar="•" PlaceholderText="Passwort" Width="180" />
          <Button Content="Entsperren" IsDefault="True" Click="OnUnlockClick" />
        </StackPanel>
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="12,4" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <ProgressBar Name="WordProgress" IsIndeterminate="True" IsVisible="False" Width="80" MinWidth="80" VerticalAlignment="Center" />
          <TextBlock Name="WordText" VerticalAlignment="Center" />
          <Button Name="WordPdfButton" Content="Words PDF" IsVisible="False" Padding="8,2" Click="OnWordPdfClick"
                  ToolTip.Tip="Öffnet Words PDF im PDF-Programm" />
          <TextBlock Text="Seite" VerticalAlignment="Center" Margin="8,0,0,0" />
          <TextBox Name="PageBox" Width="56" MinWidth="56" MinHeight="24" Padding="6,2" HorizontalContentAlignment="Right"
                   KeyDown="OnPageKey" ToolTip.Tip="Seitenzahl eingeben, Eingabetaste springt hin" />
          <TextBlock Name="PageCount" Text="von 0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Panel>
      <TextBlock Name="Placeholder" Text="Wähle ein Word-Dokument (.docx) aus oder ziehe es hierher."
                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
      <ScrollViewer Name="ErrorPanel" IsVisible="False">
        <SelectableTextBlock Name="ErrorText" Margin="16" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace" />
      </ScrollViewer>
      <NativeWebView Name="Web" IsVisible="False" Focusable="True" />
      <ScrollViewer Name="SkiaScroll" IsVisible="False" Focusable="True" HorizontalScrollBarVisibility="Auto" Background="#7f7f7f">
        <local:ScenesView Name="ScenePages" />
      </ScrollViewer>
    </Panel>
  </DockPanel>
</Window>
