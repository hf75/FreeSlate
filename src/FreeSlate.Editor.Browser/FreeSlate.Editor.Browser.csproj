<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Published ahead of time, the browser's speed then is the desktop's. Needs the workload wasm-tools. -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\FreeSlate.Editor\Assets\FreeSlate.ico" Link="wwwroot\favicon.ico" />
    <!-- The shelf's fonts, which the page fetches when a document needs them (EngineFonts.Prepare). -->
    <Content Include="..\FreeSlate.Editor\Fonts\**\*.ttf;..\FreeSlate.Editor\Fonts\**\*.txt" Link="wwwroot\fonts\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.2" />
    <!-- The engine's HarfBuzz (14.2), statically linked into the page's WebAssembly; Avalonia's own is 8.3. -->
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.2.1.301" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreeSlate.Editor\FreeSlate.Editor.csproj" />
  </ItemGroup>

</Project>
