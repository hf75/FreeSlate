<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FreeSlate.Presenter.MainWindow"
        Title="FreeSlate Presenter"
        Width="1200" Height="800" MinWidth="640" MinHeight="400">
  <DockPanel>
    <Border Name="Toolbar" DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="OpenButton" Content="Datei öffnen …" Click="OnOpenClick" />
        <Button Name="StartButton" Content="Präsentation starten" Classes="accent" IsEnabled="False" Click="OnStartClick" />
        <StackPanel Name="PasswordPanel" Orientation="Horizontal" Spacing="8" IsVisible="False">
          <TextBox Name="PasswordBox" PasswordChar="•" PlaceholderText="Passwort" Width="180" />
          <Button Content="Entsperren" IsDefault="True" Click="OnUnlockClick" />
        </StackPanel>
        <TextBlock Name="StatusText" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>
    </Border>
    <Panel>
      <TextBlock Name="Placeholder" Text="Wähle eine PowerPoint-Präsentation (.pptx) aus."
                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
      <NativeWebView Name="Web" IsVisible="False" />
    </Panel>
  </DockPanel>
</Window>
